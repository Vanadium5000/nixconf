{
  "name": "nixconf",
  "private": true,
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "./rebuild.sh --no-notify lint",
    "build:docs": "bun run --cwd packages/bunjs-docs build",
    "build:vpn-proxy-web": "bun run --cwd packages/bunjs-vpn-proxy build:web-ui",
    "test:vpn-proxy": "bun run --cwd packages/bunjs-vpn-proxy test"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/node": "25.0.3",
    "markdownlint-cli2": "0.21.0",
    "prettier": "3.8.2"
  }
}
